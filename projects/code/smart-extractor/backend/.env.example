# Copy to .env and edit. With no key the app runs on the offline mock model.
LLM_PROVIDER=auto                  # auto | anthropic | mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium                  # low | medium | high: how hard the model thinks

DATABASE_PATH=extractor.db
MAX_REPAIRS=2                      # how many times we send validation errors back to the model
MAX_DOCUMENT_CHARS=30000
CORS_ORIGINS=["http://localhost:5173"]
