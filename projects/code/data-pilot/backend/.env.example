# Copy to .env and edit. With no key the app runs on an offline model that plans queries from templates.
LLM_PROVIDER=auto                  # auto | anthropic | mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium                  # low | medium | high

DATABASE_PATH=shop.db              # created and filled with sample data on first start
MAX_STEPS=6                        # the most model turns one question may take
QUERY_TIMEOUT_SECONDS=2            # a query running longer than this is stopped
MAX_ROWS=200                       # rows returned to the model and the browser
CORS_ORIGINS=["http://localhost:5173"]
