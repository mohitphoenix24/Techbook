# Copy to .env and edit. With no key the app runs on an offline model that follows keyword rules and templates.
LLM_PROVIDER=auto                  # auto | anthropic | mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FALLBACK_MODEL=claude-haiku-5-5   # used when the main model keeps failing
LLM_EFFORT=medium                  # low | medium | high

DATABASE_PATH=support.db           # created, with a demo shop and inbox, on first start
REFUND_AUTO_LIMIT_INR=5000         # a refund above this needs a team lead
RATE_LIMIT_PER_MINUTE=30           # model calls per person per minute
DAILY_BUDGET_USD=5                 # model spend per person per day

# DEMO sign-in tokens. Change both before you share this with anyone.
AGENT_TOKEN=agent-demo-token
LEAD_TOKEN=lead-demo-token
CORS_ORIGINS=["http://localhost:5173"]
