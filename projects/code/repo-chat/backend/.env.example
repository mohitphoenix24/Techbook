# Copy to .env and edit. With no key the app answers from the retrieved code with an offline summariser.
LLM_PROVIDER=auto                  # auto | anthropic | mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium                  # low | medium | high

TOP_K=5                            # code chunks found by search (the call graph may add a few)
MAX_REPOS=5                        # uploaded repositories kept in memory
MAX_ZIP_BYTES=5000000              # the biggest ZIP accepted
MAX_FILES=400
MAX_FILE_BYTES=200000              # a larger file is skipped
MAX_TOTAL_BYTES=4000000            # all kept files together (the defence against a ZIP bomb)
CORS_ORIGINS=["http://localhost:5173"]
