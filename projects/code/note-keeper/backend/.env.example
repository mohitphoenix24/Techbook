# Copy to .env and edit. NoteKeeper needs a real key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5         # claude-sonnet-5-5 costs half as much and works well for this agent
LLM_EFFORT=medium                 # low | medium | high
MAX_STEPS=10                      # the most model calls one request may use
NOTES_DIR=notes                   # the ONLY folder the agent can see. Sample notes are created here on first start
MAX_NOTE_CHARS=20000              # the longest note that can be written
MAX_NOTES=200                     # the most notes the folder may hold
CORS_ORIGINS=["http://localhost:5173"]
