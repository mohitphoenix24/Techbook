# Copy to .env and edit. With no key the app runs on an offline model.
LLM_PROVIDER=auto                  # auto | anthropic | mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# How text becomes vectors:
#   hash       built in, no download, matches WORDS (the default; fast and fine for learning)
#   fastembed  real semantic vectors, local (pip install -r requirements-semantic.txt; ~70 MB download)
#   voyage     hosted embeddings from Voyage AI (needs VOYAGE_API_KEY)
EMBEDDINGS_PROVIDER=hash
VOYAGE_API_KEY=

DATABASE_PATH=askdocs.db
CHUNK_SIZE=700                     # characters per chunk
CHUNK_OVERLAP=120
TOP_K=5                            # passages sent to the model
CORS_ORIGINS=["http://localhost:5173"]
