# Copy to .env and edit. Nothing here is required: with no key the app runs in
# offline "mock" mode, so you can build the whole stack before paying for tokens.

# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise the offline mock
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Where conversations are stored (a single SQLite file)
DATABASE_PATH=pocketchat.db

# Calls per minute per client IP on /api/chat (0 = no limit)
RATE_LIMIT_PER_MINUTE=30

# The Vite dev server. Add your real site here when you deploy.
CORS_ORIGINS=["http://localhost:5173"]
