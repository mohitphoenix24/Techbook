# Copy to .env and edit. TaskPal needs a real key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5         # claude-sonnet-5-5 costs half as much and works well for this agent
LLM_EFFORT=medium                 # low | medium | high
MAX_STEPS=8                       # the most model calls one request may use: the brake on a runaway agent
DATABASE_PATH=tasks.db            # created on first start
TIMEZONE=Asia/Kolkata             # what "today" means for the get_today tool
CORS_ORIGINS=["http://localhost:5173"]
