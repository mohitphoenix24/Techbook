# Copy to .env and edit. WeatherWise needs a real key: https://console.anthropic.com/
# The weather itself comes from Open-Meteo (https://open-meteo.com), which needs no key.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5         # claude-sonnet-5-5 costs half as much and works well for this agent
LLM_EFFORT=medium                 # low | medium | high
MAX_STEPS=8                       # the most model calls one request may use
WEATHER_TIMEOUT_SECONDS=8         # how long a weather request may take before the tool reports an error
CORS_ORIGINS=["http://localhost:5173"]
