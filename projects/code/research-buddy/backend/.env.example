# Copy to .env and edit. ResearchBuddy needs a real key: https://console.anthropic.com/
# Web search must be enabled for your organisation (it is on by default; an admin can turn it off in the Console settings).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5         # claude-sonnet-5-5 costs half as much and also supports web search
LLM_EFFORT=medium                 # low | medium | high
MAX_STEPS=6                       # the most model calls one question may use
MAX_SEARCHES=4                    # the most web searches one question may use. Each costs $0.01 on top of the tokens
SEARCH_COUNTRY=IN                 # two-letter country code that localises results ("" for none)
CORS_ORIGINS=["http://localhost:5173"]
